{
  "name": "rydar-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "check": "tsc --noEmit",
    "deploy": "vercel deploy --prod --yes",
    "build": "node scripts/build-pages.mjs && node scripts/check-seo.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "node --import ./test/ts-resolve.mjs --test test/*.test.ts test/*.test.mjs",
    "start": "node dist/render.js",
    "build:render": "npm run build && tsc -p tsconfig.render.json"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.19"
  }
}
