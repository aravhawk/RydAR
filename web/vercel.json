{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "^/index(?:\\.html)?/?$",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "^/(arkansas-curve-map|iphone-app|how-it-works|data-and-privacy)(?:\\.html|/)$",
      "headers": { "Location": "/$1" },
      "status": 308
    },
    {
      "src": "^/(arkansas-curve-map|iphone-app|how-it-works|data-and-privacy)$",
      "dest": "/$1.html"
    },
    {
      "src": "^/api/(.*)$",
      "headers": { "X-Robots-Tag": "noindex" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/404.html", "status": 404 }
  ]
}
